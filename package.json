{
  "name": "lowpoly-uv-inspector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:core": "esbuild scripts/test-core.ts --bundle --format=esm --platform=node --outfile=node_modules/.tmp/core.mjs && node node_modules/.tmp/core.mjs",
    "test:rules": "esbuild scripts/test-rules.ts --bundle --format=esm --platform=node --outfile=node_modules/.tmp/rules.mjs && node node_modules/.tmp/rules.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "xatlas-wasm": "^0.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
